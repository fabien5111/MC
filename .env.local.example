# Copier vers .env.local et remplir. Les clés publiques Supabase sont exposées
# côté client (préfixe NEXT_PUBLIC_) ; ANTHROPIC_API_KEY reste côté serveur.

NEXT_PUBLIC_SUPABASE_URL=https://acbabqolghhyxksouaye.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_lWH25Aszggrc6ZttxyMTig_XwXs_IAG

# Serveur uniquement — ne jamais préfixer par NEXT_PUBLIC_
# Clé service_role Supabase (Settings → API). Requise uniquement par la
# fonctionnalité « connecter en tant que » (génération du lien temporaire et
# journal d'audit). Contourne la RLS : ne jamais l'exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
TRANSCRIBE_MODEL=claude-sonnet-5
IMPORT_MODEL=claude-haiku-4-5
MODERATION_MODEL=claude-sonnet-5
# Score IA (0-100) sur les avis déposés depuis une fournée terminée — n'aide
# que la modération humaine, ne bloque jamais (cf. CLAUDE.md « Avis sur une
# recette »).
COMMENT_MODERATION_MODEL=claude-haiku-4-5
# Recherche externe (étape 3) : modèle rapide imposé par le budget de temps de
# la route — l'appel enchaîne recherche web, lecture des pages et jugement.
EXTERNAL_SEARCH_MODEL=claude-haiku-4-5
IMPORT_DAILY_QUOTA=20

# Essai gratuit (lib/trial.ts) — empreinte salée de l'adresse e-mail, pour que
# la ligne `trials` survive à la suppression d'un compte sans conserver de
# donnée personnelle en clair. Générer une chaîne aléatoire longue, et ne
# JAMAIS la changer ensuite : ça invaliderait toutes les empreintes déjà
# enregistrées.
TRIAL_EMAIL_SALT=

# Tâche planifiée quotidienne (expiration des abonnements + notifications,
# cf. app/api/cron/abonnements). Vercel ajoute automatiquement l'en-tête
# `Authorization: Bearer <CRON_SECRET>` à ses propres appels programmés dès
# que cette variable existe — générer une chaîne aléatoire longue.
CRON_SECRET=

# SMTP (AWS SES) — notifications d'abonnement par e-mail. Best-effort : sans
# ces variables, les e-mails ne partent pas mais rien d'autre n'est bloqué
# (cf. lib/mail.ts). Identifiants SMTP IAM (pas les clés AWS elles-mêmes).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Je pâtisse ! <notifications@jepatisse.com>"
