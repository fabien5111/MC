# Copier vers .env.local et remplir. Les clés publiques Supabase sont exposées
# côté client (préfixe NEXT_PUBLIC_) ; ANTHROPIC_API_KEY reste côté serveur.

NEXT_PUBLIC_SUPABASE_URL=https://acbabqolghhyxksouaye.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_lWH25Aszggrc6ZttxyMTig_XwXs_IAG

# Serveur uniquement — ne jamais préfixer par NEXT_PUBLIC_
# Clé service_role Supabase (Settings → API). Requise uniquement par la
# fonctionnalité « connecter en tant que » (génération du lien temporaire et
# journal d'audit). Contourne la RLS : ne jamais l'exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
TRANSCRIBE_MODEL=claude-sonnet-5
IMPORT_MODEL=claude-haiku-4-5
MODERATION_MODEL=claude-sonnet-5
# Score IA (0-100) sur les avis déposés depuis une fournée terminée — n'aide
# que la modération humaine, ne bloque jamais (cf. CLAUDE.md « Avis sur une
# recette »).
COMMENT_MODERATION_MODEL=claude-haiku-4-5
# Recherche externe (étape 3) : modèle rapide imposé par le budget de temps de
# la route — l'appel enchaîne recherche web, lecture des pages et jugement.
EXTERNAL_SEARCH_MODEL=claude-haiku-4-5
IMPORT_DAILY_QUOTA=20

# Essai gratuit (lib/trial.ts) — empreinte salée de l'adresse e-mail, pour que
# la ligne `trials` survive à la suppression d'un compte sans conserver de
# donnée personnelle en clair. Générer une chaîne aléatoire longue, et ne
# JAMAIS la changer ensuite : ça invaliderait toutes les empreintes déjà
# enregistrées.
TRIAL_EMAIL_SALT=

# Tâche planifiée quotidienne (expiration des abonnements + notifications,
# cf. app/api/cron/abonnements). Vercel ajoute automatiquement l'en-tête
# `Authorization: Bearer <CRON_SECRET>` à ses propres appels programmés dès
# que cette variable existe — générer une chaîne aléatoire longue.
CRON_SECRET=

# SMTP AWS SES — un seul client (lib/email.ts) pour l'outil de test du
# back-office (/admin/test-email), les notifications d'abonnement par
# e-mail (app/api/cron/abonnements) ET le module contact/Jira : best-effort
# pour ces dernières (sans ces variables, les e-mails ne partent pas mais
# rien d'autre n'est bloqué), erreur remontée pour l'outil de test.
# Identifiants SMTP créés dans la console SES (Paramètres SMTP →
# Informations d'identification IAM SMTP), pas les clés d'accès AWS.
SES_SMTP_HOST=
SES_SMTP_PORT=587
SES_SMTP_USER=
SES_SMTP_PASSWORD=
SES_SENDER_EMAIL=

# Formulaire de contact et suivi Jira — cf. CLAUDE.md « Contact et suivi
# Jira » et docs/contact-jira.md pour le détail des décisions.
CONTACT_NOTIFICATION_TO=
EMAIL_REPLY_TO=
# Signe le jeton anti-robot du formulaire (délai minimum de 3 s) — sans elle,
# le délai reste actif mais non signé (dégradé, jamais bloquant). Générer une
# chaîne aléatoire longue.
CONTACT_FORM_SECRET=
# Sel de hachage des adresses IP du formulaire — jamais stockées en clair.
# Générer une chaîne aléatoire longue, et ne JAMAIS la changer ensuite (même
# motif que TRIAL_EMAIL_SALT).
IP_HASH_SALT=

JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE_BUG=
# Noms EXACTS des statuts Jira (§3/§10 de docs/contact-jira.md) — l'id
# (JIRA_STATUS_TO_DEPLOY_ID / JIRA_STATUS_DEPLOYED_ID) est testé en priorité
# quand il est renseigné, car il survit à un renommage dans Jira.
JIRA_STATUS_TO_DEPLOY=Terminé
JIRA_STATUS_TO_DEPLOY_ID=
JIRA_STATUS_DEPLOYED=Déployé
JIRA_STATUS_DEPLOYED_ID=
# Secret du webhook système Jira (Réglages → Système → Avancé → WebHooks) —
# PAS une règle Jira Automation, pour ne pas consommer le quota du plan
# gratuit. Générer une chaîne aléatoire longue.
JIRA_WEBHOOK_SECRET=
